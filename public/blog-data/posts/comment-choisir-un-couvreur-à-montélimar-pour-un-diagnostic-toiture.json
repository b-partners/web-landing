            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "umemm8487",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Un artisan expérimenté connaît bien les contraintes locales : ensoleillement intense l’été, vents fréquents (notamment le mistral), épisodes de pluie soutenue à l’automne. Ces conditions spécifiques nécessitent des matériaux adaptés et une mise en œuvre rigoureuse.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "0wm8d8488",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Un couvreur qui travaille régulièrement dans le secteur saura adapter son diagnostic et ses conseils à la réalité climatique de Montélimar.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
