                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " repose sur plusieurs critères incontournables : qualifications, assurances, devis clairs et réputation locale. Un diagnostic sérieux doit être détaillé, documenté et adapté aux particularités climatiques de la région.",
              "decorations": []
            }
          }
