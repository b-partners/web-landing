          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Un défaut d’isolation représente jusqu’à 30 % de pertes de chaleur. C’est donc un point essentiel lors d’une rénovation énergétique.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
