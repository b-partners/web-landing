                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est essentiel pour tout propriétaire ou gestionnaire de bien : cela permet d’anticiper les réparations, de dialoguer efficacement avec les couvreurs et de valoriser son patrimoine immobilier. Ce guide détaille les principaux composants d’un toit, leur rôle et les points de vigilance à connaître absolument.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
