                "id": "kbf8m6729",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le diagnostic toiture à Versailles prévient les infiltrations et protège des intempéries franciliennes.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "94xxv6732",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "liy0d6731",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Il permet d’anticiper les réparations et de mieux gérer les coûts d’entretien.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "0xad36734",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "qhcmc6733",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Il valorise le bien immobilier, notamment lors d’une vente.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "sqed86736",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "n3v7b6735",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Les nouvelles technologies comme le drone rendent l’inspection plus précise et sécurisée.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
