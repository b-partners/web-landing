                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le charpentier assure la conception, la fabrication et la pose des structures porteuses de la toiture.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "kemid5614",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "srefu5613",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "À Toulouse, il doit composer avec un patrimoine bâti ancien et des normes modernes d’isolation ou d’énergie.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "r99kh5616",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "yxmtg5615",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Son expertise est incontournable pour toute réhabilitation, surélévation ou création d’ossature bois.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
