                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": ", grâce à des images exploitables et comparables au fil du temps.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          }
        ],
        "bulletedListData": {
          "indentation": 0
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "hv5fk627",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Cette solution s’adapte aussi bien aux maisons individuelles, aux immeubles collectifs qu’aux bâtiments anciens du centre historique. Pour en savoir plus, découvrez notre service d’inspection toiture par drone.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
