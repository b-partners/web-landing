  "richContent": {
    "nodes": [
      {
        "type": "IMAGE",
        "imageData": {
          "image": {
            "src": {
              "url": "https://static.wixstatic.com/media/nsplsh_8c2db0976f1d4d869cfcd12565195d00~mv2.jpg/v1/fill/w_1000,h_667,al_c,q_85,usm_0.66_1.00_0.01/nsplsh_8c2db0976f1d4d869cfcd12565195d00~mv2.jpg"
