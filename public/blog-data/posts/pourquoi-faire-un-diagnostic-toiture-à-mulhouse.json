            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est donc une étape essentielle pour assurer la durabilité de votre couverture, éviter les infiltrations et maintenir la valeur de votre bien.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
