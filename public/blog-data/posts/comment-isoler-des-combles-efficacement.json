                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "3yup17732",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "sis7w7731",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Une bonne isolation passe aussi par une ventilation maîtrisée pour éviter la condensation.",
