          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Qu’est-ce que le chien assis en toiture moderne ?",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          }
