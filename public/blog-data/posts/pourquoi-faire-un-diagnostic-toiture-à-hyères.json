            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "1hpcp510",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Avec les nouvelles technologies comme l’inspection par drone, ce diagnostic est désormais plus rapide, précis et sécurisé. Chez ",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Birdia",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": ", nous associons expertise technique et imagerie aérienne pour proposer aux habitants de Hyères des diagnostics fiables et complets. Une solution innovante et durable, parfaitement adaptée aux conditions climatiques du littoral varois.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
