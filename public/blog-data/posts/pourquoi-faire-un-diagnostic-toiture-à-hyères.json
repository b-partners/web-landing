                      "text": ", grâce à des images exploitables et comparables d’une année à l’autre.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          }
        ],
        "bulletedListData": {
