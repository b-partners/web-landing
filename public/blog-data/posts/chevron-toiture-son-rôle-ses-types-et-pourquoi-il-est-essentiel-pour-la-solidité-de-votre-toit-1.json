            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Qu’est-ce qu’un chevron et à quoi sert-il en toiture ?",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          }
        ],
        "headingData": {
          "level": 2,
