                    "textData": {
                      "text": " : possibilité de comparer les clichés d’une inspection à l’autre pour suivre l’évolution des désordres.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          }
        ],
        "bulletedListData": {
          "indentation": 0
        }
      },
      {
        "type": "PARAGRAPH",
