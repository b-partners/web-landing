              {
                "type": "PARAGRAPH",
                "id": "nw58c2990",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Il valorise le bien immobilier dans un marché dynamique de l’est francilien.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "8s7l72993",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "x74s82992",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "L’inspection par drone offre une alternative moderne, rapide et sécurisée.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
