        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Cette technologie est particulièrement adaptée aux maisons anciennes du centre-ville, aux immeubles collectifs et aux pavillons modernes en périphérie. Pour en savoir plus, découvrez notre service d’inspection toiture par drone.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
