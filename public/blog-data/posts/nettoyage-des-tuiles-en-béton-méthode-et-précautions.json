                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Un traitement antimousse et hydrofuge prolonge la durée de vie du toit.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
