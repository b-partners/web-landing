                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "La sécurité est primordiale : une toiture se nettoie toujours avec des protections adaptées.",
                      "decorations": []
                    }
                  }
                ],
