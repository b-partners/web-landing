                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Elle peut dégrader l’isolant, la charpente et favoriser les moisissures.",
                      "decorations": []
                    }
