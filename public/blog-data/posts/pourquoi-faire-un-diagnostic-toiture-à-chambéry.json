          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Avec l’apport des nouvelles technologies comme l’inspection par drone, cette opération est aujourd’hui plus rapide, plus fiable et parfaitement sécurisée. Chez ",
              "decorations": []
            }
          },
