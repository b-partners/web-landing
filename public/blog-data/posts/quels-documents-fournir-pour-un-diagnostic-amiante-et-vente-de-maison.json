                    "textData": {
                      "text": " : si le logement a été construit avant 1949.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
