          }
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "npg8j10101",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "En plus du diagnostic amiante, plusieurs contrôles sont obligatoires selon la nature et la localisation du bien :",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
