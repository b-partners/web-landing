                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Il permet de détecter les infiltrations, fissures, tuiles cassées ou défauts d’isolation.",
                      "decorations": []
                    }
