                "id": "id1zw7435",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Elle existe en plusieurs matériaux : zinc, PVC, aluminium, cuivre.",
