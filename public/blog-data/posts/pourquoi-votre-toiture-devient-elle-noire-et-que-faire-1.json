              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " ou des ",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
