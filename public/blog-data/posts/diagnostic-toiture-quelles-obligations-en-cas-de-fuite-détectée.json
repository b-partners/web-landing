            "id": "1oanl6885",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "lqfwz6884",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Selon la gravité, des travaux peuvent être exigés avant la vente ou négociés dans le prix.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "khdrw6887",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "un72u6886",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Ce constat peut avoir un impact direct sur les assurances et la responsabilité civile.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
