            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "ostts6900",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Prenons le cas d’un appartement à Paris dont la toiture commune présente une infiltration autour d’une cheminée. Lors du diagnostic technique immobilier, la ",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "fuite toiture",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est clairement signalée avec photos à l’appui. Le rapport recommande des travaux estimés à 7 500 €, incluant le remplacement des solins et la reprise de l’étanchéité. L’acquéreur, informé de la situation, accepte l’achat mais obtient une réduction de prix équivalente au coût des réparations. Sans ce constat officiel, il aurait pu, après découverte de l’infiltration, engager une procédure contre le vendeur pour vice caché. Cet exemple illustre l’importance d’un rapport clair et documenté, qui protège les deux parties. Pour aller plus loin, découvrez aussi notre page sur l’",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "inspection toiture par drone",
              "decorations": [
                {
                  "type": "LINK",
                  "linkData": {
                    "link": {
                      "target": "BLANK",
                      "url": "https://www.birdia.fr/"
                    }
                  }
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": ", une méthode moderne et précise pour documenter les défauts.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
