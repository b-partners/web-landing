                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le vendeur est tenu d’informer l’acheteur de l’existence du problème.",
                      "decorations": []
                    }
