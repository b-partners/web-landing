                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": " : lorsque le rapport conclut que la toiture du garage ne contient pas de fibres d’amiante, le diagnostic a une validité permanente. Aucun nouveau contrôle n’est requis, sauf si des doutes apparaissent ou si des travaux modifient la toiture.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
