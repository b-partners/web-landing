              {
                "type": "PARAGRAPH",
                "id": "3hr6z1041",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "L’usage des drones et de l’IA révolutionne l’inspection et le diagnostic toiture.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
