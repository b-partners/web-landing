          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " Quelles sont les formations disponibles, les étapes à franchir et les débouchés dans ce secteur en pleine demande ? Cet article détaille le parcours à suivre pour exercer ce métier porteur.",
              "decorations": []
            }
