                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Lorsque des travaux d’isolation ou de réfection de toiture sont prévus, afin de vérifier leur pertinence.",
                      "decorations": []
