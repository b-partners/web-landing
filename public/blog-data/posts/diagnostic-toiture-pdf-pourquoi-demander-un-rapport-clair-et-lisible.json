                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " permet de conserver une trace officielle et datée des observations du professionnel. Ce document inclut généralement :",
              "decorations": []
