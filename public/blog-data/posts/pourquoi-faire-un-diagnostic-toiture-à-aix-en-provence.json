      {
        "type": "PARAGRAPH",
        "id": "j9ckz8514",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Aix-en-Provence est riche d’un patrimoine varié : hôtels particuliers du centre historique, bastides provençales aux toits de tuiles canal, et quartiers résidentiels modernes. Chaque type de bâtiment impose des exigences spécifiques en matière de couverture.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "BULLETED_LIST",
        "id": "hpt8o8521",
        "nodes": [
          {
            "type": "LIST_ITEM",
            "id": "86jfh8516",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "k0dz98515",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
