                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Les villas contemporaines, souvent équipées de toits-terrasses, demandent une surveillance régulière de l’étanchéité et des évacuations d’eau.",
