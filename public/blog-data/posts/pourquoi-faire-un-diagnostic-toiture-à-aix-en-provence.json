          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est une étape essentielle pour assurer la pérennité de son bien, anticiper les réparations et préserver la valeur de son patrimoine immobilier.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
