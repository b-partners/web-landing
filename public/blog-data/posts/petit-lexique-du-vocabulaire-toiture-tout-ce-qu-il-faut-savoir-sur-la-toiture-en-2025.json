      {
        "type": "HEADING",
        "id": "ya67u6680",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Les termes généraux à connaître absolument",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          }
        ],
        "headingData": {
          "level": 2,
