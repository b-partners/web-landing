                "id": "34p9z8425",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le rapport fournit une estimation des travaux à prévoir et peut influencer le prix de vente.",
