                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le diagnostic toiture n’est pas systématiquement obligatoire mais devient une exigence dans de nombreux cas (prêt bancaire, vente sécurisée).",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
