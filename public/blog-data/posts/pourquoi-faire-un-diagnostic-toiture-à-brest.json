        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "1llxi6765",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "En anticipant ces problèmes, les propriétaires évitent des réparations coûteuses et prolongent la durée de vie de leur couverture. Un diagnostic toiture complet constitue donc une véritable assurance face aux aléas climatiques brestois.",
              "decorations": []
            }
