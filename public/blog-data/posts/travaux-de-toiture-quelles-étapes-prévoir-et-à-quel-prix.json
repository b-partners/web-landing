            "textData": {
              "text": "diagnostic de l’état de la toiture",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": ". Celui-ci permet de déterminer si une réparation localisée suffit ou si une réfection complète est nécessaire. Cette évaluation porte sur la couverture (tuiles, ardoises, zinc), la charpente, l’isolation et la zinguerie.Vient ensuite la ",
              "decorations": []
            }
          },
