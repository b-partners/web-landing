                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Les aides d’État visent avant tout les travaux d’amélioration énergétique.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "ytxd36156",
            "nodes": [
              {
