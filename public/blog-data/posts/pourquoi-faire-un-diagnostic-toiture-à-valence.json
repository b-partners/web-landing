        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Cette technologie est idéale pour les toitures complexes, les immeubles collectifs et les maisons anciennes du centre-ville. Pour en savoir plus, consultez notre page dédiée à l’inspection toiture par drone.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
