                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le diagnostic toiture à Valence identifie les défauts liés au climat local (mistral, chaleur, pluies).",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "n60gv6673",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "40ibb6672",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Il permet d’anticiper les réparations et d’éviter des frais élevés.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "mgjcz6675",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "xc1wh6674",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Il valorise un bien immobilier lors d’une vente ou d’une mise en location.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "zcm3x6677",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "fqpkq6676",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "L’inspection par drone offre une alternative moderne, rapide et sécurisée.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
