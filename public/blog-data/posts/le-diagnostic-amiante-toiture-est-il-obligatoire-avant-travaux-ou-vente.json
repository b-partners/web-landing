          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "diagnostic amiante toiture",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est-il obligatoire ? À quelles conditions ? Et comment s’organiser avant une vente ou des travaux ? Cet article répond à toutes vos questions réglementaires et pratiques.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
