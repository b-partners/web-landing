      {
        "type": "PARAGRAPH",
        "id": "vyj6x8074",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Un bon couvreur n’hésitera pas à montrer des exemples de réalisations ou à fournir des coordonnées de clients satisfaits. Certains acceptent même des visites de chantiers en cours, preuve de leur transparence.",
