      {
        "type": "PARAGRAPH",
        "id": "79x9m8075",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "L’expérience locale est également déterminante. Les toitures du sud de la France doivent résister à des conditions particulières : soleil intense, fortes pluies automnales, épisodes de vent. Un couvreur de Béziers habitué à ces contraintes saura vous conseiller les matériaux les plus adaptés, comme la tuile canal traditionnelle.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
