              "text": "gouttière",
              "decorations": [
                {
                  "type": "ITALIC"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " sont souvent confondus. Pourtant, ils renvoient à deux dispositifs bien distincts d’évacuation des eaux pluviales. Comprendre la ",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "différence chéneau gouttière",
              "decorations": [
                {
                  "type": "ITALIC"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est essentiel pour choisir le bon système selon la configuration de votre toit, ou encore pour planifier des travaux d’entretien ou de rénovation. Cet article vous aide à y voir clair, en expliquant les caractéristiques, avantages et contraintes de chaque dispositif.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "HEADING",
        "id": "0f18q9763",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "À retenir",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          }
        ],
        "headingData": {
          "level": 2,
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "BULLETED_LIST",
        "id": "q3hxg9772",
        "nodes": [
          {
            "type": "LIST_ITEM",
            "id": "5eanm9765",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "6wez29764",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le chéneau est intégré à la toiture ou au bâti, la gouttière est rapportée.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "erwyf9767",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "e66bf9766",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Les chéneaux conviennent aux grandes surfaces de toit ou architectures complexes.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "zgi0e9769",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "v87o29768",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Les gouttières sont plus faciles à poser, à entretenir et à remplacer.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "zyael9771",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "gb54r9770",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Un entretien régulier évite infiltrations et dégradations de maçonnerie.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          }
        ],
        "bulletedListData": {
