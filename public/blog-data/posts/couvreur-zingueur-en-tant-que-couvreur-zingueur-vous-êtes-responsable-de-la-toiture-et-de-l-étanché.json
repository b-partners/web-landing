          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": ", une ressource utile pour compléter vos expertises terrain. Rejoignez les nombreux artisans indépendants qui utilisent déjà ",
              "decorations": []
