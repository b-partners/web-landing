        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Cette technologie est idéale pour les grandes toitures industrielles, les immeubles collectifs et les maisons situées en front de mer. Pour en savoir plus, consultez notre page dédiée à l’inspection toiture par drone.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
