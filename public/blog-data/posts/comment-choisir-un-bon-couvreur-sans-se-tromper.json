                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Comparer plusieurs devis permet d’éviter les mauvaises surprises.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
