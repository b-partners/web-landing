              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " lors de la vente ou de la rénovation. Cet article explique en détail ce que couvre la loi OATE et quelles sont vos obligations en 2025.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
