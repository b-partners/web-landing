                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " sans monter sur la couverture. Grâce aux technologies d’inspection à distance, il est possible d’identifier les infiltrations avec précision, sans échafaudage ni démontage.",
