        "id": "8bjo83694",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Le prix dépend de la surface du bâtiment, de l’accessibilité de la charpente et du niveau d’expertise requis. En 2025, on distingue trois grandes catégories :",
              "decorations": []
            }
          }
