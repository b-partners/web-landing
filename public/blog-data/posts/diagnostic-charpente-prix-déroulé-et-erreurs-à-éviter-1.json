                    "textData": {
                      "text": "Le diagnostic charpente détecte l’humidité, les parasites et les faiblesses structurelles.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
