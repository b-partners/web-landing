      {
        "type": "PARAGRAPH",
        "id": "fxcmo3692",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Le ",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
