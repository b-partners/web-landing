          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "À Angers, les toitures subissent les effets conjugués de la pluie, de l’humidité et des variations de température. Les tuiles en terre cuite, très répandues, peuvent se fissurer, tandis que les ardoises et les éléments de zinguerie se dégradent avec le temps.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "PARAGRAPH",
        "id": "da2tk10017",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Un ",
              "decorations": []
            }
