          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est une étape indispensable pour anticiper les problèmes, assurer la sécurité des habitants et préserver la valeur des biens immobiliers.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
