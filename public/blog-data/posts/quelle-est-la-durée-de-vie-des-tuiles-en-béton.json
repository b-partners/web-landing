              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "eq3i25871",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "q9zip5870",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Une inspection régulière permet d’anticiper les signes de vieillissement.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "84eeg5873",
            "nodes": [
              {
                "type": "PARAGRAPH",
