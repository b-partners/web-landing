                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " permet d’anticiper les dégradations, d’assurer la pérennité du bâti et de mieux planifier les travaux d’entretien. Ce contrôle est devenu incontournable pour les propriétaires soucieux de protéger leur bien.",
              "decorations": []
            }
