                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " est alors un véritable atout : il permet de disposer d’un état des lieux clair et argumenté, facilitant les démarches administratives et les arbitrages budgétaires.",
              "decorations": []
            }
          }
