        "id": "u01mx1807",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Avignon attire de nombreux investisseurs et particuliers désireux de rénover ou de vendre un bien. Le ",
              "decorations": []
