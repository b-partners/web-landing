      },
      {
        "type": "PARAGRAPH",
        "id": "y00c91812",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Les images haute définition capturées permettent de repérer les failles, d’établir un diagnostic fiable et d’éditer un rapport clair avec préconisations. Cette solution est particulièrement adaptée aux contraintes d’accès et aux toitures anciennes. Elle permet aussi une réactivité importante en cas de sinistre ou de nécessité de décision rapide.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
