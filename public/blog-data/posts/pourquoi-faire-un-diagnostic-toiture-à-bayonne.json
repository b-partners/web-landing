        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Grâce aux nouvelles technologies comme l’inspection par drone, cette démarche est désormais plus rapide, plus précise et totalement sécurisée. Chez ",
              "decorations": []
            }
          },
          {
            "type": "TEXT",
            "id": "",
