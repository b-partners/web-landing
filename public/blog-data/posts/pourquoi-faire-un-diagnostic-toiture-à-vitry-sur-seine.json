      },
      {
        "type": "HEADING",
        "id": "6p81k3158",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Une inspection efficace grâce à des solutions locales et technologiques",
              "decorations": [
                {
                  "type": "BOLD"
