                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "xb5q26470",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "wi75y6469",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Le choix d’un professionnel doit se baser sur des certifications, des références et la transparence du rapport fourni.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
