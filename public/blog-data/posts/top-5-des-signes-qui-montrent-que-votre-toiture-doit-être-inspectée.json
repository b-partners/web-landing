                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Des tuiles manquantes ou cassées doivent être traitées rapidement.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          },
          {
            "type": "LIST_ITEM",
            "id": "h39it6625",
            "nodes": [
              {
                "type": "PARAGRAPH",
                "id": "o7pto6624",
                "nodes": [
                  {
                    "type": "TEXT",
                    "id": "",
                    "nodes": [],
                    "textData": {
                      "text": "Des mousses et débris excessifs peuvent cacher des dommages structurels.",
                      "decorations": []
                    }
                  }
                ],
                "paragraphData": {
                  "textStyle": {
                    "textAlignment": "AUTO"
                  }
                }
              }
            ]
          }
        ],
        "bulletedListData": {
