        "id": "rfbdx6026",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "À retenir",
              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          }
        ],
        "headingData": {
          "level": 2,
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
      {
        "type": "BULLETED_LIST",
        "id": "5qgdc6035",
        "nodes": [
          {
            "type": "LIST_ITEM",
            "id": "wyl6p6028",
