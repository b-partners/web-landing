              "decorations": [
                {
                  "type": "BOLD"
                }
              ]
            }
          },
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": " constitue une solution moderne et adaptée aux contraintes urbaines. Elle permet d’obtenir un diagnostic précis, même sur des toits difficiles d’accès, sans recourir à des échafaudages, et en fournissant des images détaillées pour appuyer l’analyse.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      },
