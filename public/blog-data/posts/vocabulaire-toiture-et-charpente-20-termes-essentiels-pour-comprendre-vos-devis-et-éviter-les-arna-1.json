      {
        "type": "PARAGRAPH",
        "id": "cl1ju1944",
        "nodes": [
          {
            "type": "TEXT",
            "id": "",
            "nodes": [],
            "textData": {
              "text": "Connaître les termes techniques liés à la toiture, ce n’est pas devenir couvreur, c’est devenir un client averti. Cela permet de lire un devis avec discernement, d’identifier les points critiques d’un chantier, et surtout d’échanger à égalité avec les artisans. Chez Birdia, nous avons fait le choix de la clarté : nos diagnostics de toiture sont visuels, argumentés, exempts de jargon inutile. Grâce à nos technologies d’inspection par drone et intelligence artificielle, vous obtenez une lecture simple et fiable de l’état de votre toiture, sans montée sur le toit ni mauvaise surprise. Informez-vous, faites les bons choix et laissez Birdia faire le reste.",
              "decorations": []
            }
          }
        ],
        "paragraphData": {
          "textStyle": {
            "textAlignment": "AUTO"
          }
        }
      }
